APP_NAME=Siscon API
APP_VERSION=0.1.0
DEBUG=true

# Use pooler URI when direct DB timeout occurs:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase JWT Secret or local dev secret
JWT_SECRET_KEY=your_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USER_ID=
AUTH_MODE=dev
FRONTEND_URL=